{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "host/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "host/**/*.test.ts",
    "host/test-support/**/*.ts",
    "host/test-helpers/**/*.ts"
  ]
}
